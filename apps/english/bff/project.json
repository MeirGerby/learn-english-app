{
  "name": "@learn-english/english-bff",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/english/bff/src",
  "projectType": "application",
  "// targets": "build/dev/preview are inferred by @nx/vite/plugin - run: nx show project @learn-english/english-bff",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.app.json",
        "cwd": "apps/english/bff"
      },
      "cache": true,
      "inputs": ["default", "^production"],
      "dependsOn": [
        {
          "target": "build",
          "projects": [
            "@learn-english/english-contract",
            "@learn-english/db",
            "@learn-english/logging",
            "@learn-english/bff"
          ]
        }
      ]
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node dist/main.js",
        "cwd": "apps/english/bff"
      },
      "dependsOn": ["build"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "apps/english/bff"
      },
      "cache": true,
      "inputs": ["default", "^production"]
    }
  },
  "tags": ["type:bff", "scope:english", "lang:node"]
}
