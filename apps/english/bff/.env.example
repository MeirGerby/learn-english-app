PORT=3001
NODE_ENV=development
LOG_LEVEL=info
SERVICE_ENVIRONMENT=

# Neon: the pooled URL for the app, the direct one for migrations.
DATABASE_URL=postgresql://user:password@localhost:5432/learn_english
DATABASE_URL_UNPOOLED=
DATABASE_SSL=false

JWT_SECRET=SECRET_HERE
JWT_EXPIRES_IN=30d

# Comma-separated. Emails that become admins when they register.
ADMIN_EMAILS=teacher@example.com

# Comma-separated browser origins allowed to call the BFF.
CORS_ORIGIN=http://localhost:5173
# Base of the password-reset link sent by email.
FRONTEND_URL=http://localhost:5173/learn-english-app

# Leave empty to log reset links instead of sending email (development).
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
