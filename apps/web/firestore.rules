rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in ['meirg2001@gmail.com', 'hodayashalom1@gmail.com'];
    }

    // Admin improvement/feedback log - only the two admin accounts may
    // read, create, or delete entries. Regular signed-in users have no
    // access to this collection at all.
    match /feedback/{feedbackId} {
      allow read, write: if isAdmin();
    }

    // Word bank: readable by everyone (including anonymous visitors, so
    // games work without forcing login) but only admins can add/edit/seed
    // words - regular users must not be able to tamper with the content.
    match /words/{wordId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Per-user cumulative stats and achievements (score, correct/incorrect
    // counts, unlocked achievements). Each user may only read/write their
    // own document, keyed by their auth uid. Note: this only checks
    // ownership, not the values being written - a user could in principle
    // write inflated stats to their own doc via the client SDK. Accepted
    // tradeoff for a personal/family app with no competitive stakes; would
    // need a Cloud Function to validate server-side if that ever matters.
    match /userStats/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Course content (videos/images for Hodaya's course). Any signed-in
    // user may view it - only admins may add/remove items.
    match /courseContent/{itemId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Everything else is denied by default (no other rules match).
  }
}
