{
  "name": "learn-english-monorepo",
  "private": true,
  "packageManager": "npm@11.17.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.9"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "allowScripts": {
    "@firebase/util@1.12.1": true,
    "protobufjs@7.6.5": true,
    "esbuild@0.18.20": true,
    "esbuild@0.28.2": true,
    "esbuild@0.19.12": true,
    "argon2@0.45.1": true,
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true
  }
}
