{
  "name": "@learn-english/source",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nx run-many -t dev -p @learn-english/english-bff @learn-english/english-web",
    "db:generate": "cd libs/ts/db && drizzle-kit generate",
    "db:migrate": "nx build @learn-english/db && node libs/ts/db/dist/migrate.js",
    "db:seed": "nx build @learn-english/db && node libs/ts/db/dist/seed.js",
    "format": "nx run-many -t format",
    "format:check": "nx run-many -t format:check"
  },
  "devDependencies": {
    "@nx/js": "23.2.1",
    "@nx/oxlint": "23.2.1",
    "@nx/react": "23.2.1",
    "@nx/vite": "23.2.1",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "drizzle-kit": "^0.31.10",
    "nx": "23.2.1",
    "oxfmt": "0.76.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "nx": {
    "tags": [
      "lang:node",
      "scope:tooling"
    ],
    "targets": {
      "format": {
        "executor": "nx:run-commands",
        "options": {
          "command": "oxfmt",
          "cwd": "{workspaceRoot}"
        }
      },
      "format:check": {
        "executor": "nx:run-commands",
        "options": {
          "command": "oxfmt --check",
          "cwd": "{workspaceRoot}"
        }
      }
    }
  }
}
